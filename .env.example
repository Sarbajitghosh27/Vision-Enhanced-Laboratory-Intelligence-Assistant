# ==============================================================================
# VELIA — Vision-Enhanced Laboratory Intelligence Assistant Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI API Keys (CRITICAL FOR LIVE & HOSTED DEPLOYMENTS)
# ------------------------------------------------------------------------------
# NOTE FOR RENDER DEPLOYMENT:
# In Render Dashboard -> Your Web Service -> Environment -> Add Environment Variables.
# Local .env files are gitignored and NOT pushed to Render.

# Groq API Key (Free tier, 14,400 req/day — powers RAG Assistant & fast reasoning)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# Google Gemini API Key (Powers Breadboard Computer Vision & Syllabus Generation)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Local LLM / Ollama Configuration (Optional offline mode)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ------------------------------------------------------------------------------
# 3. Backend Network Configuration
# ------------------------------------------------------------------------------
# When running the Streamlit frontend locally against a local FastAPI server:
# API_BASE_URL=http://127.0.0.1:8000/api
#
# When running against the live hosted Render deployment:
API_BASE_URL=https://vision-enhanced-laboratory-intelligence.onrender.com/api

# Server Bind Port (Used by uvicorn / main.py)
PORT=8000
HOST=0.0.0.0
